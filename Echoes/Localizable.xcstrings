        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开着的时候，即使没检测到人脸也会给一个表情判定（准确率较低，结果会标注「可能不准」）。关掉之后会提示你重拍，要求必须拍到完整人脸。"
          }
        }
