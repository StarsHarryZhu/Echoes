    "%@ %@": {
      "comment": "A label that describes the accessibility of the view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@，%lld 张": {
      "comment": "A string that describes the accessibility label for the view, combining the emotion name and the count of items associated with that emotion. The first argument is the name of the emotion. The second argument is the count of items.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@，%2$lld 张"
          }
        }
      }
    },
    "%lld": {
      "comment": "A badge displaying the number of items in a category. The argument is the count of items in the category.",
      "isCommentAutoGenerated": true
    },
