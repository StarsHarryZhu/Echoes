      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, you still get a result even if no face is detected (less accurate — it’s marked “may be inaccurate”). When off, we ask you to retake until a full face is captured."
